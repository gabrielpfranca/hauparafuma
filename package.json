{
  "name": "hauparafuma",
  "version": "1.0.0",
  "private": true,
  "description": "Hau Para Fuma — aplikasaun apoiu para fuma iha lian Tetun, ba Timor-Leste. Tetum-language smoking cessation PWA, structured after the WHO/ITU mTobaccoCessation handbook.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/server.js",
    "serve": "node tools/serve.js 8080",
    "server": "node server/server.js",
    "icons": "node tools/make-icons.mjs",
    "test": "node --test tests/unit.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:origin": "node tests/single-origin.mjs",
    "test:all": "npm test && npm run test:i18n && npm run test:smoke && npm run test:origin",
    "test:i18n": "node --test tests/translation.mjs",
    "review:bake": "node tools/translation-bake.mjs",
    "review:pull": "node tools/translation-bake.mjs --dry"
  },
  "keywords": [
    "tetum",
    "tetun",
    "timor-leste",
    "smoking-cessation",
    "mhealth",
    "who",
    "mtobaccocessation",
    "pwa",
    "offline-first"
  ]
}
