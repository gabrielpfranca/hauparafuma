# Dependencies. The app itself has none; node_modules here only ever holds
# symlinks to a globally installed Playwright for running the smoke test.
node_modules/

# Community server data (JSON store created at runtime)
server/data*/

# tests/screens/ is intentionally NOT ignored: the smoke test writes it, but the
# review tool (server/review.js) also serves these images as context for the
# reviewer, so they need to ship with the deployed app. Re-run `npm run
# test:smoke` and commit the result after any UI change that affects a screen.

# Logs and editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
